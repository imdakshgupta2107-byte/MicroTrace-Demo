# PIN-based demo build. Set to live only for the separate email-account workspace.
VITE_APP_MODE=demo
# Optional temporary cross-device request sharing for the PIN demo.
# This is a demo transport, not authenticated access; leave false for local-only mode.
VITE_DEMO_SHARED_REQUESTS=false
# PUBLIC Supabase URL/key used only when VITE_DEMO_SHARED_REQUESTS=true.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional external chemical-name lookup. Off by default.
VITE_PUBCHEM_ENABLED=false
# Demo-only convenience PINs. Ignored as authority in a live build.
VITE_PRINCIPAL_PIN=0000
VITE_STAFF_PIN=1111
VITE_TEACHER_PIN=2222
# NEVER put Gmail credentials, refresh tokens, service-role or secret keys in VITE_*.
# Generate private server settings with the local setup helpers in scripts/.
