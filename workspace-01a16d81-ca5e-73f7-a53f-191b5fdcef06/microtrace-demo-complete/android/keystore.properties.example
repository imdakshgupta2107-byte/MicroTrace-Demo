# OPTIONAL command-line release signing; see BUILD-APK.md.
# Copy to android/keystore.properties, set your own values, and keep it PRIVATE.
# storeFile is relative to the android/ directory; use forward slashes on Windows.
storeFile=release-keystore.jks
storePassword=YOUR_PRIVATE_KEYSTORE_PASSWORD
keyAlias=microtrace
keyPassword=YOUR_PRIVATE_KEY_PASSWORD
